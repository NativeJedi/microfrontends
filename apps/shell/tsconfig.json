{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Types of remote modules come from the remotes' source (monorepo only), see ADR 0006.
    // Webpack ignores this: at runtime `catalog/*` is still loaded through Module Federation.
    "paths": {
      "catalog/*": ["../catalog/src/exposed/*"],
      "cart/*": ["../cart/src/exposed/*"]
    }
  },
  "include": ["src"]
}
