{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "types": {
      "outputs": ["types/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^types"]
    },
    "lint": {}
  }
}
